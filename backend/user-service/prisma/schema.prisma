generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(uuid())
  firstName     String
  lastName      String?
  username      String  @unique
  email         String  @unique
  password_hash String

  gender       Gender?
  dob          Int?
  profileImage String?
  bio          String?

  tierId String?
  tier   SubscriptionTier? @relation(fields: [tierId], references: [id])

  verified   Boolean @default(false)
  newsletter Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  CUSTOM
}

model UserOTPVerification {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SubscriptionTier {
  id    String @id @default(uuid())
  slug  String @unique
  price Int

  base_store_limit       Int @default(1)
  base_team_member_limit Int @default(0)
  base_product_limit     Int @default(50)
  base_ai_daily_limit    Int @default(100)

  features Json? @default("{}")

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum STATUS {
  SUCCESS
  FAILED
  PENDING
  EXPIRED
  INVALID
  QUEUED
  PROCESSING
}
